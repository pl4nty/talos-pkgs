Subject: [PATCH] riscv: dts: th1520: power the Lichee Pi 4A Wi-Fi module

The RTL8723DS on sdio1 never answers (error -110 whilst initialising SDIO
card) because nothing turns on its 3.3 V supply. The vendor device tree
enables it with GPIO2_29 (regulator "soc_wcn33_en", active high). Describe
that supply and hand it to sdio1 as vmmc-supply, so the MMC core powers the
module before the pwrseq releases its reset.

--- a/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
+++ b/arch/riscv/boot/dts/thead/th1520-lichee-pi-4a.dts
@@ -47,6 +47,15 @@
 		post-power-on-delay-ms = <200>;
 	};
 
+	reg_wcn33: regulator-wcn33 {
+		compatible = "regulator-fixed";
+		regulator-name = "wcn33_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio2 29 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	thermal-zones {
 		cpu-thermal {
 			polling-delay = <1000>;
@@ -167,6 +176,7 @@
 	cap-sdio-irq;
 	keep-power-in-suspend;
 	mmc-pwrseq = <&wifi_pwrseq>;
+	vmmc-supply = <&reg_wcn33>;
 	non-removable;
 	status = "okay";
 };
